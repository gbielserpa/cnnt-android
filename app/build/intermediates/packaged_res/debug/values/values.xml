<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1E1E1E</color>
    <color name="ic_launcher_foreground">#00B0FF</color>
    <string name="app_name">CNNT</string>
    <style name="Theme.CNNT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00B0FF</item>
        <item name="colorPrimaryVariant">#0091EA</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#651FFF</item>
        <item name="colorSecondaryVariant">#6200EA</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#1E1E1E</item>
        <item name="android:navigationBarColor">#1E1E1E</item>
        <item name="android:windowBackground">#1E1E1E</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Theme.CNNT.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>